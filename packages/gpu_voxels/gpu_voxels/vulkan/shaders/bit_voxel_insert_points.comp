#version 450
#extension GL_GOOGLE_include_directive : enable
#include "bit_voxel_common.glsl"
// Insert world-space points: voxel = floor(point / voxel_side_length). Points outside the map (incl. negative
// coordinates, NaN, inf) are counted in outside_count and not inserted.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Map { uint words[]; };
layout(std430, set = 0, binding = 1) readonly buffer Points { float points[]; }; // x, y, z packed (stride 3)
layout(std430, set = 0, binding = 2) buffer Outside { uint outside_count; };
layout(push_constant) uniform Push
{
    uint dim_x;
    uint dim_y;
    uint dim_z;
    uint count;
    uint meaning;
    float voxel_side_length;
} pc;

void main()
{
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < pc.count; i += stride)
    {
        const vec3 p = vec3(points[3u * i], points[3u * i + 1u], points[3u * i + 2u]);
        const vec3 f = floor(p / pc.voxel_side_length);
        // Comparisons with NaN are false, so NaN falls into the "outside" branch.
        const bool inside = f.x >= 0.0 && f.x < float(pc.dim_x) &&
                            f.y >= 0.0 && f.y < float(pc.dim_y) &&
                            f.z >= 0.0 && f.z < float(pc.dim_z);
        if (inside)
        {
            const uvec3 c = uvec3(f);
            const uint voxel = (c.z * pc.dim_y + c.y) * pc.dim_x + c.x;
            atomicOr(words[voxel * WORDS_PER_VOXEL + meaning_word(pc.meaning)], meaning_mask(pc.meaning));
        }
        else
        {
            atomicAdd(outside_count, 1u);
        }
    }
}
