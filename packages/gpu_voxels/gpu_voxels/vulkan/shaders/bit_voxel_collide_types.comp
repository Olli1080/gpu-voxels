#version 450
#extension GL_GOOGLE_include_directive : enable
#include "bit_voxel_common.glsl"
// Type-aware collision of two maps of identical size (CUDA: SVCollider with window 0 / sv_offset 0, as used by
// BitVoxelMap::collideWithTypes). The colliding bits of a voxel pair are (a & b) without bits 0..3 (FREE, OCCUPIED,
// COLLISION, UNKNOWN); the voxels collide when that is non-zero. Colliding voxels of the first map get the
// eBVM_COLLISION bit, the number of collisions and the OR of all colliding bits are returned in result:
// result[0] = count, result[1 .. 8] = the 8 words of the colliding-bits vector.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Mine { uint mine[]; };
layout(std430, set = 0, binding = 1) readonly buffer Other { uint other[]; };
layout(std430, set = 0, binding = 2) buffer Result { uint result[9]; };
layout(push_constant) uniform Push { uint voxel_count; } pc;

shared uint group_count;
shared uint group_types[WORDS_PER_VOXEL];

void main()
{
    if (gl_LocalInvocationIndex == 0u)
        group_count = 0u;
    if (gl_LocalInvocationIndex < WORDS_PER_VOXEL)
        group_types[gl_LocalInvocationIndex] = 0u;
    barrier();

    uint local_count = 0u;
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < pc.voxel_count; i += stride)
    {
        const uint base = i * WORDS_PER_VOXEL;
        uint collided[WORDS_PER_VOXEL];
        uint any_bit = 0u;
        for (uint w = 0u; w < WORDS_PER_VOXEL; ++w)
        {
            uint c = mine[base + w] & other[base + w];
            if (w == 0u)
                c &= 0xFFFFFFF0u;
            collided[w] = c;
            any_bit |= c;
        }
        if (any_bit != 0u)
        {
            mine[base + meaning_word(BVM_COLLISION)] |= meaning_mask(BVM_COLLISION);
            ++local_count;
            for (uint w = 0u; w < WORDS_PER_VOXEL; ++w)
                if (collided[w] != 0u)
                    atomicOr(group_types[w], collided[w]);
        }
    }

    atomicAdd(group_count, local_count);
    barrier();
    if (gl_LocalInvocationIndex == 0u && group_count != 0u)
        atomicAdd(result[0], group_count);
    if (gl_LocalInvocationIndex < WORDS_PER_VOXEL && group_types[gl_LocalInvocationIndex] != 0u)
        atomicOr(result[1u + gl_LocalInvocationIndex], group_types[gl_LocalInvocationIndex]);
}
