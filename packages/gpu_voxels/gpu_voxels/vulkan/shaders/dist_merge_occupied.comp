#version 450
#extension GL_GOOGLE_include_directive : enable
// CUDA DistanceVoxelMap::mergeOccupied: every voxel whose probabilistic occupancy is > level becomes an obstacle.
layout(local_size_x = 64) in;
#include "dist_common.glsl"
layout(std430, set = 0, binding = 0) readonly buffer Prob { uint prob[]; };
layout(std430, set = 0, binding = 1) buffer Voxels { uint voxels[]; };
layout(push_constant) uniform Push { uint dim_x; uint dim_y; uint dim_z; uint voxel_count; int level; } pc;

void main()
{
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    const uvec3 dim = uvec3(pc.dim_x, pc.dim_y, pc.dim_z);
    for (uint i = gl_GlobalInvocationID.x; i < pc.voxel_count; i += stride)
        if (int(prob[i]) > pc.level)
            voxels[i] = dist_pack(coords_of_id(i, dim));
}
