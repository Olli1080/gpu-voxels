#version 450
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_GOOGLE_include_directive : require
#include "morton.glsl"
// World-space points (3 floats per point: x, y, z) -> Morton ids (2 words, low first), voxel = floor(point / voxel_side_length) as in the
// other Vulkan maps. A point whose voxel does not lie inside the 2^14 grid (negative, too far, NaN, inf) gets the sentinel id 2^42 (sorts
// behind every valid id) and is counted in dropped[0]. Points first .. first + n - 1 of the buffer are converted to ids 0 .. n - 1.
layout(local_size_x = 64) in;
#include "octree_gid.glsl"
layout(std430, set = 0, binding = 0) readonly buffer Points { float points[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Ids { uint ids[]; };
layout(std430, set = 0, binding = 2) buffer Dropped { uint dropped[]; };
layout(push_constant) uniform Push { uint n; uint first; float voxel_side_length; } pc;

void main()
{
    const uint i = oct_gid();
    if (i >= pc.n)
        return;
    const uint p = 3u * (pc.first + i);
    const vec3 f = floor(vec3(points[p], points[p + 1u], points[p + 2u]) / pc.voxel_side_length);
    uint64_t id = 1ul << 42;
    // comparisons with NaN are false, so NaN takes the dropped branch
    if (f.x >= 0.0 && f.x < 16384.0 && f.y >= 0.0 && f.y < 16384.0 && f.z >= 0.0 && f.z < 16384.0)
        id = morton_code60(uvec3(f));
    else
        atomicAdd(dropped[0], 1u);
    ids[2u * i] = uint(id & 0xFFFFFFFFul);
    ids[2u * i + 1u] = uint(id >> 32);
}
