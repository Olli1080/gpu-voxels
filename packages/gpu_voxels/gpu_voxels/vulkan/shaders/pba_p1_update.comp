#version 450
#extension GL_GOOGLE_include_directive : enable
// PBA phase 1, update step (CUDA kernelPBAphase1Update): one invocation per (x, y, band). Replaces the obstacle of every
// voxel of the band by the obstacle found for the band bottom / top (in `initial`) if that one is closer.
// Deviation from CUDA: an uninitialised bottom / top entry is never used (CUDA compares |1023 - z|, which can win for
// maps whose z extent is close to 1023).
layout(local_size_x = 64) in;
#include "pba_common.glsl"
layout(std430, set = 0, binding = 0) readonly buffer Initial { uint initial[]; };
layout(std430, set = 0, binding = 1) buffer Data { uint data[]; };
layout(push_constant) uniform Push { uint nx; uint ny; uint nz; uint band_size; uint count; } pc;

void main()
{
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    const int nx = int(pc.nx), ny = int(pc.ny);
    const int band_size = int(pc.band_size);
    const int layer = nx * ny;
    for (uint t = gl_GlobalInvocationID.x; t < pc.count; t += stride)
    {
        const int tx = int(t % pc.nx);
        const int ty = int((t / pc.nx) % pc.ny);
        const int band = int(t / (pc.nx * pc.ny));
        const int tz_bottom = band * band_size;
        const int bottom_id = tz_bottom * layer + ty * nx + tx;
        const int top_id = bottom_id + (band_size - 1) * layer;
        const ivec3 left = pba_load(initial[bottom_id]);
        const ivec3 right = pba_load(initial[top_id]);

        for (int i = 0; i < band_size; ++i)
        {
            const int id = bottom_id + i * layer;
            ivec3 current = pba_load(data[id]);
            bool found = false;
            int min_dist = current.z == PBA_U ? 0x7FFFFFFF : abs(current.z - (tz_bottom + i));
            if (left.z != PBA_U)
            {
                const int d = abs(left.z - (tz_bottom + i));
                if (d < min_dist)
                {
                    current = left;
                    min_dist = d;
                    found = true;
                }
            }
            if (right.z != PBA_U)
            {
                const int d = abs(right.z - (tz_bottom + i));
                if (d < min_dist)
                {
                    current = right;
                    min_dist = d;
                    found = true;
                }
            }
            if (found)
                data[id] = pba_store(current);
        }
    }
}
