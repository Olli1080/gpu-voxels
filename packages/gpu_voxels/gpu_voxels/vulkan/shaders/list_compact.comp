#version 450
// Stream compaction of list entries: entry i with flags[i] != 0 is copied to position pos[i] + dst_offset
// (pos = exclusive scan of flags). Order is preserved.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer SrcIds { uint src_ids[]; };
layout(std430, set = 0, binding = 1) readonly buffer SrcCoords { uint src_coords[]; };
layout(std430, set = 0, binding = 2) readonly buffer SrcVox { uint src_vox[]; };
layout(std430, set = 0, binding = 3) readonly buffer Flags { uint flags[]; };
layout(std430, set = 0, binding = 4) readonly buffer Pos { uint pos[]; };
layout(std430, set = 0, binding = 5) writeonly buffer DstIds { uint dst_ids[]; };
layout(std430, set = 0, binding = 6) writeonly buffer DstCoords { uint dst_coords[]; };
layout(std430, set = 0, binding = 7) writeonly buffer DstVox { uint dst_vox[]; };
layout(push_constant) uniform Push { uint count; uint words; uint dst_offset; } pc;

void main()
{
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < pc.count; i += stride)
    {
        if (flags[i] == 0u)
            continue;
        const uint o = pos[i] + pc.dst_offset;
        dst_ids[o] = src_ids[i];
        dst_coords[3u * o] = src_coords[3u * i];
        dst_coords[3u * o + 1u] = src_coords[3u * i + 1u];
        dst_coords[3u * o + 2u] = src_coords[3u * i + 2u];
        for (uint w = 0u; w < pc.words; ++w)
            dst_vox[o * pc.words + w] = src_vox[i * pc.words + w];
    }
}
