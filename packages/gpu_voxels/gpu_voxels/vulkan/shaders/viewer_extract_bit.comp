#version 450
// Cubes of a BitVoxelMap: one cube for every voxel that has a meaning whose palette colour is not transparent. The colour is the one of the lowest such
// meaning. Voxel (x, y, z) is the cube [x, x + 1) * side ... (linear index z * dx * dy + y * dx + x, 8 words per voxel).
#extension GL_GOOGLE_include_directive : enable
#include "viewer_cube_common.glsl"
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer Voxels { uint voxels[]; };
layout(std430, set = 0, binding = 1) readonly buffer Palette { uint palette[]; }; // 256 packed colours, alpha 0 = hidden
layout(std430, set = 0, binding = 2) writeonly buffer Instances { CubeInstance instances[]; };
layout(std430, set = 0, binding = 3) buffer Args { uint args[]; };
layout(push_constant) uniform Push { uint dim_x; uint dim_y; uint dim_z; uint capacity; float side; } pc;

void main()
{
    const uint voxel_count = pc.dim_x * pc.dim_y * pc.dim_z;
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < voxel_count; i += stride)
    {
        uint colour = 0u;
        for (uint w = 0u; w < 8u && colour == 0u; ++w)
        {
            uint bits = voxels[i * 8u + w];
            while (bits != 0u && colour == 0u)
            {
                const uint c = palette[w * 32u + uint(findLSB(bits))];
                if ((c >> 24u) != 0u)
                    colour = c;
                bits &= bits - 1u;
            }
        }
        if (colour == 0u)
            continue;
        const uint x = i % pc.dim_x;
        const uint y = (i / pc.dim_x) % pc.dim_y;
        const uint z = i / (pc.dim_x * pc.dim_y);
        const uint slot = atomicAdd(args[ARG_FOUND], 1u);
        if (slot < pc.capacity)
        {
            instances[slot].pos_size = vec4(vec3(x, y, z) * pc.side, pc.side);
            instances[slot].rgba = colour;
            instances[slot].pad0 = 0u;
            instances[slot].pad1 = 0u;
            instances[slot].pad2 = 0u;
        }
    }
}
