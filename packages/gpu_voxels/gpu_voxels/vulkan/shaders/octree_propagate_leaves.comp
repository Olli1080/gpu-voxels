#version 450
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_GOOGLE_include_directive : require
// Propagate for the nodes of level 1 (deterministic tree): items = addresses of level 1 nodes with PART. Invalid leaves (all occupancy
// bits set) take all bits except PART / LAST_LEVEL from the node, then the node is recomputed from its 8 leaves (CUDA getNewStatus with
// LAST_LEVEL) and loses NEEDS_UPDATE. One invocation per node: it owns the whole leaf block.
#define OCT_PROB 0
#include "octree_nodes.glsl"

layout(local_size_x = 64) in;
#include "octree_gid.glsl"
layout(std430, set = 0, binding = 0) readonly buffer Items { uint items[]; };
layout(push_constant) uniform Push { uint count; } pc;

layout(buffer_reference, std430, buffer_reference_align = 8) buffer OctNodeRef { uint w0; uint w1; };
layout(buffer_reference, std430, buffer_reference_align = 4) buffer OctWords { uint w[2]; };

const uint OCT_NEEDS_UPDATE = 128u;

void main()
{
    const uint g = oct_gid();
    if (g >= pc.count)
        return;
    OctNodeRef node = OctNodeRef(packUint2x32(uvec2(items[2u * g], items[2u * g + 1u])));
    const uint nw0 = node.w0;
    const uint node_status = nw0 & 255u;
    const uint64_t block = oct_sign_extend_48(uint64_t(nw0 >> 16u) | (uint64_t(node.w1) << 16u));
    OctWords leaves = OctWords(block);
    OctNode kids[8];
    for (uint k = 0u; k < 8u; ++k)
    {
        uint status = (leaves.w[k >> 2u] >> ((k & 3u) * 8u)) & 255u;
        if ((status & OCT_OCCUPANCY_MASK) == OCT_OCCUPANCY_MASK)
            status = (status & (OCT_PART | OCT_LAST_LEVEL)) | (node_status & ~(OCT_PART | OCT_LAST_LEVEL) & 255u);
        kids[k].status = status;
        kids[k].flags = 0u;
        kids[k].occupancy = 0;
        kids[k].child = 0ul;
    }
    for (uint w = 0u; w < 2u; ++w)
        leaves.w[w] = kids[4u * w].status | (kids[4u * w + 1u].status << 8u) | (kids[4u * w + 2u].status << 16u) | (kids[4u * w + 3u].status << 24u);
    const OctNode parent = oct_parent(kids, 1u, 0ul);
    const uint flags = ((nw0 >> 8u) & 255u) & ~OCT_NEEDS_UPDATE;
    node.w0 = (nw0 & 0xFFFF0000u) | parent.status | (flags << 8u);
}
