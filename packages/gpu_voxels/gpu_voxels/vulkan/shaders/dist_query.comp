#version 450
#extension GL_GOOGLE_include_directive : enable
// Squared obstacle distance (CUDA DistanceVoxel::squaredObstacleDistance) of the voxels with the given linear indices.
layout(local_size_x = 64) in;
#include "dist_common.glsl"
layout(std430, set = 0, binding = 0) readonly buffer Voxels { uint voxels[]; };
layout(std430, set = 0, binding = 1) readonly buffer Indices { uint indices[]; };
layout(std430, set = 0, binding = 2) writeonly buffer Out { int squared[]; };
layout(push_constant) uniform Push { uint dim_x; uint dim_y; uint dim_z; uint count; } pc;

void main()
{
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    const uvec3 dim = uvec3(pc.dim_x, pc.dim_y, pc.dim_z);
    for (uint i = gl_GlobalInvocationID.x; i < pc.count; i += stride)
        squared[i] = dist_squared_distance(voxels[indices[i]], coords_of_id(indices[i], dim));
}
