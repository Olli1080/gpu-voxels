#version 450
#extension GL_GOOGLE_include_directive : enable
#include "list_entry.glsl"
// Writes the flagged (occupied) voxels of a BitVoxelMap as list entries to dst[pos[i] + dst_offset]:
// id = voxel index, coordinates from the index, voxel = copy of the map voxel.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer MapVox { uint map_vox[]; };
layout(std430, set = 0, binding = 1) readonly buffer Flags { uint flags[]; };
layout(std430, set = 0, binding = 2) readonly buffer Pos { uint pos[]; };
layout(std430, set = 0, binding = 3) writeonly buffer DstIds { uint dst_ids[]; };
layout(std430, set = 0, binding = 4) writeonly buffer DstCoords { uint dst_coords[]; };
layout(std430, set = 0, binding = 5) writeonly buffer DstVox { uint dst_vox[]; };
layout(push_constant) uniform Push { uint voxel_count; uint dim_x; uint dim_y; uint dim_z; uint dst_offset; } pc;

void main()
{
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    const uvec3 dim = uvec3(pc.dim_x, pc.dim_y, pc.dim_z);
    for (uint i = gl_GlobalInvocationID.x; i < pc.voxel_count; i += stride)
    {
        if (flags[i] == 0u)
            continue;
        const uint o = pos[i] + pc.dst_offset;
        const uvec3 c = coords_of_id(i, dim);
        dst_ids[o] = i;
        dst_coords[3u * o] = c.x; dst_coords[3u * o + 1u] = c.y; dst_coords[3u * o + 2u] = c.z;
        for (uint w = 0u; w < WORDS_PER_VOXEL; ++w)
            dst_vox[o * WORDS_PER_VOXEL + w] = map_vox[i * WORDS_PER_VOXEL + w];
    }
}
