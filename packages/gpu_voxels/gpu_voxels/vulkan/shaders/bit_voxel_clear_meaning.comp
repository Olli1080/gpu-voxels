#version 450
#extension GL_GOOGLE_include_directive : enable
#include "bit_voxel_common.glsl"
// Clear one meaning (bit) in every voxel; all other bits stay untouched.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Map { uint words[]; };
layout(push_constant) uniform Push
{
    uint voxel_count;
    uint meaning;
} pc;

void main()
{
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < pc.voxel_count; i += stride)
        words[i * WORDS_PER_VOXEL + meaning_word(pc.meaning)] &= ~meaning_mask(pc.meaning);
}
