#version 450
#extension GL_GOOGLE_include_directive : enable
#include "bit_voxel_common.glsl"
// flags[i] = 1 if map voxel i has any bit except eBVM_FREE set.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer MapVox { uint map_vox[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Flags { uint flags[]; };
layout(push_constant) uniform Push { uint voxel_count; } pc;

void main()
{
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < pc.voxel_count; i += stride)
    {
        const uint base = i * WORDS_PER_VOXEL;
        uint bits = map_vox[base] & 0xFFFFFFFEu;
        for (uint w = 1u; w < WORDS_PER_VOXEL; ++w)
            bits |= map_vox[base + w];
        flags[i] = bits != 0u ? 1u : 0u;
    }
}
