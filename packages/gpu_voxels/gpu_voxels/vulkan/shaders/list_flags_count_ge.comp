#version 450
// flags[i] = 1 if the counting voxel (sign extended int8 in one word) is >= threshold (signed comparison).
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer Vox { uint vox[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Flags { uint flags[]; };
layout(push_constant) uniform Push { uint n; int threshold; } pc;

void main()
{
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += stride)
        flags[i] = int(vox[i]) >= pc.threshold ? 1u : 0u;
}
