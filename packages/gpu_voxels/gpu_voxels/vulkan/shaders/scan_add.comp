#version 450
// Adds the scanned block totals to every element: out[i] += offsets[i / 512].
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) buffer Out { uint out_data[]; };
layout(std430, set = 0, binding = 1) readonly buffer Offsets { uint offsets[]; };
layout(push_constant) uniform Push { uint n; } pc;

void main()
{
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += stride)
        out_data[i] += offsets[i >> 9u];
}
