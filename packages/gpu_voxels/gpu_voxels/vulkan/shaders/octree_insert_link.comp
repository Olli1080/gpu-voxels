#version 450
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_GOOGLE_include_directive : require
// Insert, step 3 (levels 13 down to 0): the head voxel of every new block on `level` initialises the block like the CUDA kernel
// kernel_insert_initNeededNodes (inner nodes: DYNAMIC (| LAST_LEVEL on level 1) and NEEDS_UPDATE, leaves: invalid status | DYNAMIC) and
// links it into its parent: the node of the block one level up (also new, its block index comes from the scan of that level) or, when the
// walk ended on level + 1, the node the walk ended on. The parent gets PART and the child address. There is exactly one head voxel per
// block and one block per parent node, so every node has one writer.
#define OCT_PROB 0
#include "octree_nodes.glsl"

layout(local_size_x = 64) in;
#include "octree_gid.glsl"
layout(std430, set = 0, binding = 0) readonly buffer Ids { uint ids[]; };
layout(std430, set = 0, binding = 1) readonly buffer Info { uvec4 info[]; };
layout(std430, set = 0, binding = 2) readonly buffer Heads { uint heads[]; };
layout(std430, set = 0, binding = 3) readonly buffer Offsets { uint excl[]; };
layout(std430, set = 0, binding = 4) readonly buffer HeadsUp { uint heads_up[]; };
layout(std430, set = 0, binding = 5) readonly buffer OffsetsUp { uint excl_up[]; };
layout(push_constant) uniform Push
{
    uint n;
    uint level;
    uint64_t base;    // first block of the new chunk of this level
    uint64_t base_up; // first block of the new chunk of level + 1
} pc;

layout(buffer_reference, std430, buffer_reference_align = 8) buffer OctNodeRef { uint w0; uint w1; };
layout(buffer_reference, std430, buffer_reference_align = 4) buffer OctWords { uint w[]; };

const uint OCT_NEEDS_UPDATE = 128u;

void main()
{
    const uint i = oct_gid();
    if (i >= pc.n || heads[i] == 0u)
        return;
    const uint64_t id = packUint2x32(uvec2(ids[2u * i], ids[2u * i + 1u]));
    const uint level = pc.level;
    const uint64_t block = pc.base + uint64_t(excl[i]) * uint64_t(oct_block_bytes(level));

    OctWords words = OctWords(block);
    if (level == 0u)
    {
        words.w[0] = 0x87878787u; // invalid (7) | DYNAMIC (128) for each of the 8 leaves
        words.w[1] = 0x87878787u;
    }
    else
    {
        const uint status = OCT_DYNAMIC | (level == 1u ? OCT_LAST_LEVEL : 0u);
        for (uint s = 0u; s < 8u; ++s)
        {
            words.w[2u * s] = status | (OCT_NEEDS_UPDATE << 8u);
            words.w[2u * s + 1u] = 0u;
        }
    }

    const uvec4 f = info[i];
    uint64_t parent;
    if (f.x == level + 1u)
        parent = packUint2x32(uvec2(f.y, f.z));
    else
    {
        const uint index_up = excl_up[i] + heads_up[i] - 1u;
        parent = pc.base_up + uint64_t(index_up) * uint64_t(OCT_INNER_BLOCK_BYTES) + uint64_t((uint(id >> (3u * (level + 1u))) & 7u) * 8u);
    }
    OctNodeRef p = OctNodeRef(parent);
    const uint w0 = p.w0;
    p.w0 = (w0 & 0xFFFFu) | OCT_PART | (uint(block & 0xFFFFul) << 16u);
    p.w1 = uint(block >> 16);
}
