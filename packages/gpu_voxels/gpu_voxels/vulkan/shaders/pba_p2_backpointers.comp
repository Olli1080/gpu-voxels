#version 450
#extension GL_GOOGLE_include_directive : enable
// PBA phase 2 (CUDA kernelPBAphase2ProximateBackpointers): one invocation per (x, band, z), walking the band (band_size
// consecutive y positions) of its line. Keeps the lower envelope of the obstacles seen so far as a stack inside `stack`:
// the entry at an obstacle position stores (obstacle.x, y of the previous stack entry, obstacle.z). If the last voxel of the
// band holds no obstacle it becomes a tail pointer (U, y of the last stack entry, U).
layout(local_size_x = 64) in;
#include "pba_common.glsl"
layout(std430, set = 0, binding = 0) readonly buffer Data { uint data[]; };
layout(std430, set = 0, binding = 1) buffer Stack { uint stack_voxels[]; };
layout(push_constant) uniform Push { uint nx; uint ny; uint nz; uint band_size; uint count; uint bands; } pc;

void main()
{
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    const int nx = int(pc.nx), ny = int(pc.ny);
    const int band_size = int(pc.band_size);
    const int row = nx;
    const int layer = nx * ny;
    for (uint t = gl_GlobalInvocationID.x; t < pc.count; t += stride)
    {
        const int tx = int(t % pc.nx);
        const int band = int((t / pc.nx) % pc.bands);
        const int tz = int(t / (pc.nx * pc.bands));
        const int ty_bottom = band * band_size;

        int last_y = PBA_U;
        ivec3 stack_top = ivec3(0, PBA_U, 0);
        ivec3 stack_second = ivec3(0, PBA_U, 0);
        ivec3 current = ivec3(PBA_U);
        const int bottom_id = tz * layer + ty_bottom * row + tx;

        for (int i = 0; i < band_size; ++i)
        {
            const int id = bottom_id + i * row;
            const int ty = ty_bottom + i;
            current = pba_load(data[id]);
            if (current.x == PBA_U) // no obstacle information (empty z column of phase 1)
                continue;

            while (stack_top.y != PBA_U)
            {
                const float intersection1 = pba_intersection(stack_second.x, stack_top.y, stack_second.z, stack_top.x, last_y, stack_top.z, tx, tz);
                const float intersection2 = pba_intersection(stack_top.x, last_y, stack_top.z, current.x, ty, current.z, tx, tz);
                if (intersection1 < intersection2)
                    break; // the top of the stack survives
                // the top is dominated by its predecessor and the current obstacle: pop it
                last_y = stack_top.y;
                stack_top = stack_second;
                if (stack_top.y != PBA_U)
                    stack_second = pba_load(stack_voxels[tz * layer + stack_top.y * row + tx]);
            }

            stack_second = stack_top;
            stack_top = ivec3(current.x, last_y, current.z);
            last_y = ty;
            stack_voxels[id] = pba_store(stack_top);
        }

        if (current.x == PBA_U) // the last voxel of the band holds no obstacle: write the tail pointer
            stack_voxels[bottom_id + (band_size - 1) * row] = pba_store(ivec3(PBA_U, last_y, PBA_U));
    }
}
