#version 450
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_GOOGLE_include_directive : require
// Insert, step 4: the datum of every voxel. A new leaf (kind 1) becomes DYNAMIC | datum (the invalid bits are replaced, CUDA setNode), an
// existing leaf (kind 0) keeps every bit except the occupancy bits and PART (CUDA updateNode with the hard reset data).
#define OCT_PROB 0
#include "octree_nodes.glsl"

layout(local_size_x = 64) in;
#include "octree_gid.glsl"
layout(std430, set = 0, binding = 0) readonly buffer Ids { uint ids[]; };
layout(std430, set = 0, binding = 1) readonly buffer Info { uvec4 info[]; };
layout(std430, set = 0, binding = 2) readonly buffer Heads0 { uint heads0[]; };
layout(std430, set = 0, binding = 3) readonly buffer Offsets0 { uint excl0[]; };
layout(push_constant) uniform Push
{
    uint n;
    uint datum;     // OCT_OCCUPIED or OCT_FREE
    uint64_t base0; // first block of the new leaf chunk (0 if there is none)
} pc;

layout(buffer_reference, std430, buffer_reference_align = 8) buffer OctNodeRef { uint w0; uint w1; };
layout(buffer_reference, std430, buffer_reference_align = 4) buffer OctWords { uint w[2]; };

void main()
{
    const uint i = oct_gid();
    if (i >= pc.n)
        return;
    const uint64_t id = packUint2x32(uvec2(ids[2u * i], ids[2u * i + 1u]));
    const uint slot = uint(id) & 7u;
    const uvec4 f = info[i];
    const uint shift = (slot & 3u) * 8u;
    if (f.w == 1u)
    {
        const uint64_t block = pc.base0 + uint64_t(excl0[i] + heads0[i] - 1u) * 8ul;
        OctWords words = OctWords(block);
        atomicAnd(words.w[slot >> 2u], ~(255u << shift));
        atomicOr(words.w[slot >> 2u], (OCT_DYNAMIC | pc.datum) << shift);
    }
    else
    {
        OctNodeRef node = OctNodeRef(packUint2x32(uvec2(f.y, f.z)));
        const uint64_t block = oct_sign_extend_48(uint64_t(node.w0 >> 16u) | (uint64_t(node.w1) << 16u));
        OctWords words = OctWords(block);
        atomicAnd(words.w[slot >> 2u], ~((OCT_OCCUPANCY_MASK | OCT_PART) << shift));
        atomicOr(words.w[slot >> 2u], pc.datum << shift);
    }
}
