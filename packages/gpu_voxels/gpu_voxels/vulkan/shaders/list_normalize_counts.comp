#version 450
// Counting voxels are int8 in CUDA: wrap the 32-bit sums to a sign extended 8 bit value.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Vox { uint vox[]; };
layout(push_constant) uniform Push { uint n; } pc;

void main()
{
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += stride)
        vox[i] = uint(((int(vox[i] & 0xFFu) ^ 0x80) - 0x80));
}
