# Script mode helper of gvl_embed_shaders():
#   cmake -DINPUT=<file.spv> -DOUTPUT=<file.cpp> -DSYMBOL=<identifier> -P EmbedSpirv.cmake
# Writes the SPIR-V words (little endian) as a uint32_t array.

file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" hex_length)
math(EXPR byte_count "${hex_length} / 2")
math(EXPR remainder "${byte_count} % 4")
if(NOT remainder EQUAL 0 OR byte_count EQUAL 0)
  message(FATAL_ERROR "EmbedSpirv: ${INPUT} is not a valid SPIR-V binary (size ${byte_count})")
endif()
math(EXPR word_count "${byte_count} / 4")

# Bytes b0 b1 b2 b3 (file order) form the word 0xb3b2b1b0.
string(REGEX REPLACE "([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])"
       "0x\\4\\3\\2\\1u," words "${hex}")
file(WRITE "${OUTPUT}"
"// Generated by cmake/EmbedSpirv.cmake from ${SYMBOL} - do not edit.
#include <cstddef>
#include <cstdint>

namespace gpu_voxels::vulkan::shaders
{
	extern const uint32_t ${SYMBOL}[];
	extern const std::size_t ${SYMBOL}_words;
	const uint32_t ${SYMBOL}[] = {
${words}
	};
	const std::size_t ${SYMBOL}_words = ${word_count};
}
")
