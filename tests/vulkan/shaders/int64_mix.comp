#version 450
#extension GL_ARB_gpu_shader_int64 : require
// Checks that shaderInt64 is enabled: result[i] = (uint64(hi[i]) << 32 | lo[i]) * 3 split into two uints.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer Hi { uint hi[]; };
layout(std430, set = 0, binding = 1) readonly buffer Lo { uint lo[]; };
layout(std430, set = 0, binding = 2) writeonly buffer Res { uvec2 res[]; };
layout(push_constant) uniform Push { uint count; } pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.count)
    {
        uint64_t v = ((uint64_t(hi[i]) << 32) | uint64_t(lo[i])) * 3ul;
        res[i] = uvec2(uint(v & 0xFFFFFFFFul), uint(v >> 32));
    }
}
