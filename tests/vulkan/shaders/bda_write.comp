#version 450
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_buffer_reference : require
// Writes through a buffer device address that is NOT bound as a descriptor: target[i] = i * 3 + 1 for i < count.
// The second binding only keeps the pipeline layout non-empty and receives the number of writes.
layout(local_size_x = 64) in;
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words { uint data[]; };
layout(std430, set = 0, binding = 0) buffer Dummy { uint written; };
layout(push_constant) uniform Push { uint64_t target; uint count; uint pad; } pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.count)
    {
        Words w = Words(pc.target);
        w.data[i] = i * 3u + 1u;
        atomicAdd(written, 1u);
    }
}
