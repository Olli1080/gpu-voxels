#version 450
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_buffer_reference : require
// Follows pointers across separately allocated buffers (the access pattern of the octree: nodes hold the address of a
// block in another buffer). Every thread starts at heads[i], follows `next` until 0 or `max_steps`, and stores
// (sum of the values, number of nodes visited).
layout(local_size_x = 64) in;
layout(buffer_reference, std430, buffer_reference_align = 8) buffer Node { uint64_t next; uint value; uint pad; };
layout(std430, set = 0, binding = 0) readonly buffer Heads { uvec2 heads[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Result { uvec2 result[]; };
layout(push_constant) uniform Push { uint count; uint max_steps; } pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.count)
    {
        uint64_t address = packUint2x32(heads[i]);
        uint sum = 0u;
        uint steps = 0u;
        while (address != 0ul && steps < pc.max_steps)
        {
            Node n = Node(address);
            sum += n.value;
            address = n.next;
            ++steps;
        }
        result[i] = uvec2(sum, steps);
    }
}
