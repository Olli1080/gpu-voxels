#version 450
// out_data[i] = in_data[i] * factor for i < count
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer In { uint in_data[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Out { uint out_data[]; };
layout(push_constant) uniform Push { uint count; uint factor; } pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.count)
        out_data[i] = in_data[i] * pc.factor;
}
