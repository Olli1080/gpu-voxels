#version 450
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_GOOGLE_include_directive : require
#include "morton.glsl"
// Exercises morton.glsl: for every record encodes (x, y, z), decodes the result again and evaluates the level helpers.
// coords[i]  = (x, y, z, level)        second[i] = (x, y, z, unused) of a second voxel
// code[i]    = (low word, high word) of morton_code60(x, y, z)
// decoded[i] = morton_decode60(morton_code60(x, y, z)), 0
// misc[i]    = (low word, high word) of morton_prefix(code, level), morton_node_index(code, level), morton_common_level(code, code of second)
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer Coords { uvec4 coords[]; };
layout(std430, set = 0, binding = 1) readonly buffer Second { uvec4 second[]; };
layout(std430, set = 0, binding = 2) writeonly buffer Code { uvec2 code[]; };
layout(std430, set = 0, binding = 3) writeonly buffer Decoded { uvec4 decoded[]; };
layout(std430, set = 0, binding = 4) writeonly buffer Misc { uvec4 misc[]; };
layout(push_constant) uniform Push { uint count; } pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.count)
    {
        const uint64_t c = morton_code60(coords[i].xyz);
        const uint64_t d = morton_code60(second[i].xyz);
        const uint level = coords[i].w;
        code[i] = uvec2(uint(c & 0xFFFFFFFFul), uint(c >> 32));
        decoded[i] = uvec4(morton_decode60(c), 0u);
        const uint64_t p = morton_prefix(c, level);
        misc[i] = uvec4(uint(p & 0xFFFFFFFFul), uint(p >> 32), morton_node_index(c, level), morton_common_level(c, d));
    }
}
